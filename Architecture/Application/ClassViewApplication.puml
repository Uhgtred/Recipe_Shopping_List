@startuml
hide empty members



class ItemListBuilder #lightblue{
    + addRecipeUnit()
    + addInstructions()
    + addDescription()
    + build()
}
ItemListBuilder ..> Recipe: <<create>>
ItemListBuilder ..> ShoppingList: <<create>>

class ItemBuilder #lightblue{
   + addUnit()
   + addName()
   + build()
}
ItemBuilder ..> ConcreteItem: <<create>>

interface InterfaceItem #lightblue{
   - unit
   - name
}
InterfaceItem ..o AbstractItemList
InterfaceItem -- Unit

class ShoppingList #lightblue
ShoppingList "0..*" --|> "1" AbstractItemList

class Recipe #lightblue {
    - instructions
    - description
    + getInstructions()
    + setInstructions()
    + getDescription()
    + setDescription()
}
Recipe "0..*" --|> "1" AbstractItemList
Recipe -- Quantity

abstract class AbstractItemList #lightblue{
   - name: const str
   - itemQuantity: [item: Quantity]
   - dataBaseName: const str
   + addItem()
   + removeItem()
   + getItems()
   + storeList()
   + changeList()
   + getName()
}

class ConcreteItem #lightblue
ConcreteItem --|> InterfaceItem

class Quantity #lightblue{
    - unit: Unit
    - quantity: int
    + getUnit()
    + getQuantity()
}

class Unit #lightblue{
    - unit: str
}

legend bottom right
| **Color**         | **Layer**             |
| <#lightblue>      | Application layer     |
end legend
@enduml

# Decisions:
1. Explicit decision to keep the Class Unit, since the application (core functionality)should be
    free of dependencies. Use-case for a dedicated Unit class may for example be the conversion to
    another unit later in development.